{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolrave",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "schoolrave.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
