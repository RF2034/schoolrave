{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolrave",
  // 開発サーバはここを読む。本番の wrangler deploy はビルドが差し替える dist/server を使う。
  // 公開 HTML は dist/client。一致する URL は Worker を起動しない。
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "schoolrave.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [{ "binding": "SESSION" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schoolrave-portal",
    },
  ],
}
