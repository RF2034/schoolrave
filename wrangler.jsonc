{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolrave",
  // 開発サーバはここを読む。本番の wrangler deploy はビルドが差し替える dist/server を使う。
  // 公開 HTML は dist/client。一致する URL は Worker を起動しない。
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "schoolrave.net", "custom_domain": true }],
  // 2026-11-20 06:00 JST（11月19日 21:00 UTC）だけ。あさみごりの次の人へ一度送る。
  // ponytail: 来年の同じ時刻に空振りする。その前にこの triggers を消す。
  "triggers": { "crons": ["0 21 19 11 *"] },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [{ "binding": "SESSION" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schoolrave-portal",
    },
  ],
  // 日記の画像と動画。バケット本体はまだ作っていない。
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "schoolrave-media",
    },
  ],
}
