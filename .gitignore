# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# astro
/.astro/
/dist/
/out/
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
public

# EmDash（ローカルの SQLite とアップロード先）
/data.db
/data.db-*
/uploads/
/.emdash/
# 開発サーバー起動時に自動生成される型（`astro dev` で再生成される）
/emdash-env.d.ts
/*.log