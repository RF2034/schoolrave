---
import Portal from "@/layouts/Portal.astro";
import { formatDate } from "@/lib/portal-format";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";

export const prerender = false;

const slug = Astro.params.slug;
const { entry } = slug ? await getEmDashEntry("diary", slug) : { entry: null };

if (!entry) {
  Astro.response.status = 404;
}

const authors = entry?.data.bylines ?? [];
---

<Portal
  title={entry ? `${entry.data.title} | 交換日記` : "交換日記 | ガッコウレイヴ"}
>
  <div class="portal__inner portal__diary">
    {
      entry ? (
        <article class="portal__section">
          <p class="portal__back">
            <a href="/portal/diary">交換日記の一覧</a>
          </p>
          <p class="portal__notice-date">
            {formatDate(entry.data.date ?? entry.data.publishedAt)}
          </p>
          <h1 class="portal__notice-title">
            {entry.data.title}
            {entry.data.mood && (
              <span class="portal__diary-mood">{entry.data.mood}</span>
            )}
          </h1>
          {authors.length > 0 && (
            <p class="portal__diary-head">
              {authors.map((credit) => (
                <span class="portal__diary-author">
                  {credit.byline.displayName}
                </span>
              ))}
            </p>
          )}
          <div class="portal__prose">
            <PortableText value={entry.data.body} />
          </div>
        </article>
      ) : (
        <section class="portal__section">
          <p class="portal__back">
            <a href="/portal/diary">交換日記の一覧</a>
          </p>
          <p class="portal__empty">この日記は見つかりません。</p>
        </section>
      )
    }
  </div>
</Portal>
