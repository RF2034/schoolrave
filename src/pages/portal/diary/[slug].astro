---
import Portal from "@/layouts/Portal.astro";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import { formatDate } from "@/lib/portal-format";

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite("/404");

const { entry } = await getEmDashEntry("diary", slug);
if (!entry) return Astro.rewrite("/404");

const authors = entry.data.bylines ?? [];
---

<Portal title={`${entry.data.title} | 交換日記`} description={entry.data.title}>
  <article class="portal__section portal__diary-entry">
    <p class="portal__back"><a href="/portal/diary">← 交換日記の一覧</a></p>

    <header>
      <p class="portal__diary-date">
        {formatDate(entry.data.date ?? entry.data.publishedAt)}
      </p>
      <h2 class="portal__section-title">{entry.data.title}</h2>
      <p class="portal__diary-head">
        {
          authors.map((credit) => (
            <span class="portal__diary-author">
              {credit.byline.displayName}
            </span>
          ))
        }
        {
          entry.data.mood && (
            <span class="portal__diary-mood">{entry.data.mood}</span>
          )
        }
      </p>
    </header>

    <div class="portal__prose">
      <PortableText value={entry.data.body} />
    </div>
  </article>
</Portal>
