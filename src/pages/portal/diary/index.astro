---
import Portal from "@/layouts/Portal.astro";
import { formatDate, plainExcerpt } from "@/lib/portal-format";
import { getEmDashCollection } from "emdash";

export const prerender = false;

const { entries } = await getEmDashCollection("diary", {
  orderBy: { date: "desc" },
  limit: 30,
});
const writeHref = "/_emdash/admin/content/diary/new";
---

<Portal title="交換日記 | ガッコウレイヴ">
  <div class="portal__inner portal__diary">
    <header class="portal__header">
      <h1 id="diary-heading" class="portal__title">交換日記</h1>
      <p class="portal__meta">
        参加者の記録です。ポータルに入れる人は、自分の日記を書けます。
      </p>
      <p class="portal__link-block">
        <a href={writeHref}>日記を書く</a>
      </p>
      {
        import.meta.env.DEV && (
          <p class="portal__note">
            ローカルでは先に
            <a href={`/_emdash/api/setup/dev-bypass?redirect=${writeHref}`}>
              開発用のログイン
            </a>
            を開いてから書きます。
          </p>
        )
      }
    </header>

    <main aria-labelledby="diary-heading">
      {
        entries.length === 0 ? (
          <section class="portal__section">
            <p class="portal__empty">まだ書き込みがありません。</p>
          </section>
        ) : (
          <ul class="portal__diary-list">
            {entries.map((entry) => {
              const excerpt = plainExcerpt(entry.data.body);
              const name =
                typeof entry.data.name === "string"
                  ? entry.data.name.trim()
                  : "";
              return (
                <li class="portal__section">
                  <p class="portal__notice-date">
                    {formatDate(entry.data.date ?? entry.data.publishedAt)}
                  </p>
                  <h2 class="portal__notice-title">
                    <a href={`/portal/diary/${entry.id}`}>{entry.data.title}</a>
                    {entry.data.mood && (
                      <span class="portal__diary-mood">{entry.data.mood}</span>
                    )}
                  </h2>
                  {name && (
                    <p class="portal__diary-head">
                      <span class="portal__diary-author">{name}</span>
                    </p>
                  )}
                  {excerpt && <p class="portal__diary-excerpt">{excerpt}</p>}
                </li>
              );
            })}
          </ul>
        )
      }
    </main>
  </div>
</Portal>
