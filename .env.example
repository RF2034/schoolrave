# EmDash 管理画面のセッション暗号化キー。参加者のログインとは別。
# `npx emdash setup` か以下で生成する。コミットしない。
# node -e "console.log('emdash_enc_v1_' + require('crypto').randomBytes(32).toString('base64url'))"
EMDASH_ENCRYPTION_KEY=

# Cloudflare Access のチームドメイン（your-team.cloudflareaccess.com。https:// は付けない）。Zero Trust > Settings でコピーする。本番ビルドでは必須。
CF_ACCESS_TEAM_DOMAIN=

# Cloudflare Access アプリケーションの AUD タグ。Zero Trust > Access controls > Applications の対象アプリの Configure > Additional settings でコピーする。本番ビルドでは必須。
CF_ACCESS_AUDIENCE=
