{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "defaultLocale": "ja",
  "meta": {
    "name": "ガッコウレイヴ 参加者ポータル",
    "description": "参加スタッフ向けポータルと交換日記",
    "author": "ガッコウレイヴ"
  },
  "settings": {
    "title": "ガッコウレイヴ 準備ポータル",
    "tagline": "参加スタッフ向け · 準備用"
  },
  "collections": [
    {
      "slug": "diary",
      "label": "交換日記",
      "labelSingular": "日記",
      "description": "参加者が日々の進捗や雑談を書き込む時系列の交換日記",
      "icon": "notebook-pen",
      "urlPattern": "/portal/diary/{slug}",
      "sortOrder": 1,
      "supports": ["drafts", "revisions", "preview", "scheduling", "search"],
      "fields": [
        {
          "slug": "title",
          "label": "見出し",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "date",
          "label": "日付",
          "type": "datetime",
          "required": true
        },
        {
          "slug": "body",
          "label": "本文",
          "type": "portableText",
          "searchable": true
        },
        { "slug": "photo", "label": "写真（任意）", "type": "image" },
        {
          "slug": "mood",
          "label": "今日の気分",
          "type": "select",
          "validation": {
            "options": [
              "わいわい",
              "もくもく",
              "ねむい",
              "たのしい",
              "しんどい"
            ]
          }
        }
      ]
    },
    {
      "slug": "notices",
      "label": "お知らせ",
      "labelSingular": "お知らせ",
      "icon": "megaphone",
      "routable": false,
      "sortOrder": 2,
      "supports": ["drafts", "revisions", "scheduling"],
      "fields": [
        {
          "slug": "title",
          "label": "見出し",
          "type": "string",
          "required": true
        },
        { "slug": "date", "label": "掲載日", "type": "datetime" },
        { "slug": "body", "label": "本文", "type": "portableText" },
        { "slug": "pinned", "label": "上部に固定", "type": "boolean" }
      ]
    },
    {
      "slug": "submissions",
      "label": "提出物",
      "labelSingular": "提出物",
      "description": "フォームやDiscordの募集・提出一覧",
      "icon": "clipboard-list",
      "routable": false,
      "sortOrder": 3,
      "supports": ["revisions"],
      "fields": [
        {
          "slug": "title",
          "label": "内容",
          "type": "string",
          "required": true
        },
        { "slug": "deadline", "label": "締切", "type": "string" },
        { "slug": "url", "label": "入力先URL", "type": "url" },
        { "slug": "link_label", "label": "リンクの表示名", "type": "string" },
        { "slug": "sort", "label": "並び順", "type": "integer" }
      ]
    },
    {
      "slug": "pages",
      "label": "固定ページ",
      "labelSingular": "ページ",
      "icon": "file-text",
      "urlPattern": "/portal/p/{slug}",
      "sortOrder": 4,
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        {
          "slug": "title",
          "label": "見出し",
          "type": "string",
          "required": true
        },
        { "slug": "body", "label": "本文", "type": "portableText" }
      ]
    }
  ],
  "bylines": [
    { "id": "byline-ops", "slug": "ops", "displayName": "運営" },
    { "id": "byline-dj", "slug": "dj-team", "displayName": "DJ班" },
    { "id": "byline-food", "slug": "food-team", "displayName": "ごはん班" }
  ],
